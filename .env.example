# Copy to .env and fill in. No real credentials belong in this file.

# Provider: groq | openai | anthropic | gemini | openrouter  (autodetected from the key if omitted)
LLM_PROVIDER=groq

# Provide ONE key matching the provider (or the generic LLM_API_KEY):
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# LLM_API_KEY=

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint (Ollama, vLLM, ...)
